   "mpu6050",
   "ความเร่ง",
   "เอียง",
   "gyro",
   "accelerometer"
  ],
  "voltage": "3.3V",
  "pins": [
   {
    "label": "VCC",
    "kind": "power3",
    "need": null,
    "role": "VCC"
   },
   {
    "label": "GND",
    "kind": "gnd",
    "need": null,
    "role": "GND"
   },
   {
    "label": "SDA",
    "kind": "signal",
    "need": "i2c_sda",
    "role": "SDA"
   },
   {
    "label": "SCL",
    "kind": "signal",
    "need": "i2c_scl",
    "role": "SCL"
   }
  ],
  "warnings": [],
  "helpers": "def mpu_read():\n    d = i2c.readfrom_mem(0x68, 0x3B, 6)\n    def s(h, l):\n        v = h << 8 | l\n        return v - 65536 if v > 32767 else v\n    return [round(s(d[i], d[i+1]) / 16384, 2) for i in (0, 2, 4)]",
  "setup": "i2c = I2C(0, sda=Pin({SDA}), scl=Pin({SCL}))\ni2c.writeto_mem(0x68, 0x6B, b'\\x00')",
  "read": "accel_x, accel_y, accel_z = mpu_read()",
  "keys": [
   "accel_x",
   "accel_y",
   "accel_z"
  ],
  "sim": [
   -1,
   1,
   "float"
  ],
  "explain_th": "วัดความเร่งสามแกน ใช้ตรวจการเอียงหรือการตก สื่อสารผ่าน I2C",
