  "setup": "hx_dt = Pin({DT}, Pin.IN)\nhx_sck = Pin({SCK}, Pin.OUT, value=0)\nHX_SCALE = 420.0   # ปรับค่านี้ตอน calibrate\nhx_offset = None",
  "helpers": "def hx_raw():\n    t = time.ticks_ms()\n    while hx_dt.value():                 # รอจนกว่า HX711 พร้อม\n        if time.ticks_diff(time.ticks_ms(), t) > 1000:\n            return None\n    v = 0\n    for _ in range(24):\n        hx_sck.value(1)\n        hx_sck.value(0)\n        v = (v << 1) | hx_dt.value()\n    hx_sck.value(1)                      # พัลส์ที่ 25 = เลือกช่อง A เกน 128\n    hx_sck.value(0)\n    if v & 0x800000:\n        v -= 0x1000000\n    return v\n\ndef hx_avg(n=5):\n    s, k = 0, 0\n    for _ in range(n):\n        r = hx_raw()\n        if r is not None:\n            s += r\n            k += 1\n    return s // k if k else 0\n\ndef read_weight():\n    global hx_offset\n    if hx_offset is None:\n        hx_offset = hx_avg(15)           # ตั้งศูนย์ครั้งแรก\n    return round((hx_avg(5) - hx_offset) / HX_SCALE, 1)",
